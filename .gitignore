# Rust
# Cargo.lock is committed deliberately (this is an application, not a published library).
/target/

# Node / Vite
/apps/web/node_modules/
/apps/web/dist/
/apps/web/.vite/
/apps/web/*.tsbuildinfo

# Local data / logs (see docs/PHASE1_SPEC.md §3)
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak
/logs/

# Written into the checkout by google-github-actions/auth in CI; ignored so the image tag isn't
# -dirty and the file isn't uploaded to Cloud Build (.gcloudignore includes this file).
gha-creds-*.json

# Editors, OS
.DS_Store
*.swp
